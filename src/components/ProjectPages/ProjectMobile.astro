---
import Image from "astro/components/Image.astro";
import Badge from "../Helper/Badge.astro";
import ProjectBreadcrumb from "./ProjectBreadcrumb.astro";
import ProjectButtons from "./ProjectButtons.astro";
import ProseWrapper from "$layouts/ProseWrapper.astro";

const { project } = Astro.props;

const images = import.meta.glob(
  "/src/assets/projects/**/*.{png,webp,jpg,jpeg}"
);
const projectImages = await Promise.all(
  (project.images || []).map(async (image: string) => images[image])
);
---

<div class="text-white font-sans min-h-screen bg-gradient-to-b from-zinc-950 via-zinc-900 to-zinc-950 relative overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#4f4f4f12_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f12_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_80%_50%_at_50%_50%,#000_60%,transparent_100%)]"></div>
    <div class="absolute top-1/4 -left-48 w-96 h-96 bg-purple-500/10 rounded-full blur-[120px] animate-pulse"></div>
    <div class="absolute bottom-1/4 -right-48 w-96 h-96 bg-cyan-500/10 rounded-full blur-[120px] animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <div class="relative pt-6 sm:pt-24 font-sans">
    <ProjectBreadcrumb name={project.name} />

    <!-- Mobile-optimized Image Gallery (3 columns of vertical screens) -->
    {
      project.images ? (
        <div class="mx-auto mt-8 max-w-2xl px-4 sm:px-6 md:max-w-5xl md:px-8">
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 md:gap-8">
            {projectImages.slice(0, 3).map((img, i) => (
              <div class="group relative aspect-[9/19] overflow-hidden rounded-[2.5rem] border border-white/10 bg-white/5 backdrop-blur-sm shadow-2xl shadow-purple-500/10 hover:shadow-purple-500/20 hover:border-white/20 transition-all duration-500">
                <div class="h-full w-full relative overflow-hidden">
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10" />
                  <Image
                    src={img()}
                    alt={`${project.name} screen ${i + 1}`}
                    height={1600}
                    width={900}
                    class="h-full w-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <slot name="demo" />
      )
    }

    <!-- Product info -->
    <div
      class="mx-auto max-w-2xl px-4 pb-0 pt-12 sm:px-6 md:grid md:max-w-5xl md:grid-cols-3 md:gap-x-8 md:px-8 md:pb-24 md:pt-16"
    >
      <div class="md:col-span-2 space-y-8">
        <div class="space-y-4">
            <h1 class="text-3xl sm:text-5xl font-bold bg-gradient-to-r from-white via-purple-200 to-blue-200 bg-clip-text text-transparent leading-tight pb-2">
                {project.name}
            </h1>
            <div class="h-1 w-20 bg-gradient-to-r from-purple-500 to-blue-500 rounded-full"></div>
        </div>

        <div class="rounded-2xl border border-white/5 bg-white/[0.02] backdrop-blur-sm p-6 sm:p-10 shadow-xl">
          <ProseWrapper>
            <div class="text-lg leading-relaxed text-neutral-200">
              <slot />
            </div>
          </ProseWrapper>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="mt-12 md:mt-0 space-y-6">
        {project.tags && (
          <div class="p-6 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-xl">
            <h3 class="text-xs font-semibold text-white/40 uppercase tracking-[0.2em] mb-4">Technologies</h3>
            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag: string) => (
                <Badge size="lg">{tag}</Badge>
              ))}
            </div>
          </div>
        )}

        <div class="p-6 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-xl">
          <h3 class="text-xs font-semibold text-white/40 uppercase tracking-[0.2em] mb-4">Quick Actions</h3>
          <div class="flex flex-col gap-3">
            <ProjectButtons
              codeUrl={project.codeUrl}
              projectUrl={project.projectUrl}
            />
          </div>
        </div>

        <div class="p-6 rounded-2xl border border-white/10 bg-gradient-to-br from-purple-500/5 to-blue-500/5 backdrop-blur-xl">
          <div class="flex items-center gap-3 text-sm text-white/70 font-medium">
            <div class="w-8 h-8 rounded-full bg-purple-500/10 border border-purple-500/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
            </div>
            <span>Built with passion</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
