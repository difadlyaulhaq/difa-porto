---
import Image from "astro/components/Image.astro";
import Badge from "../Helper/Badge.astro";
import ProjectBreadcrumb from "./ProjectBreadcrumb.astro";
import ProjectButtons from "./ProjectButtons.astro";
import ProseWrapper from "$layouts/ProseWrapper.astro";

const { project } = Astro.props;

const images = import.meta.glob(
  "/src/assets/projects/**/*.{png,webp,jpg,jpeg,svg}"
);
const projectImages = await Promise.all(
  (project.images || []).map(async (image: string) => images[image])
);

const aspectClass = project.aspect || "aspect-video";
---

<div class="text-zinc-800 font-sans min-h-screen bg-white relative overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,0,0,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.03)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_80%_50%_at_50%_50%,#000_60%,transparent_100%)]"></div>
    <div class="absolute top-1/4 -left-48 w-96 h-96 bg-sky-100/50 rounded-full blur-[120px] animate-pulse"></div>
    <div class="absolute bottom-1/4 -right-48 w-96 h-96 bg-cyan-50/50 rounded-full blur-[120px] animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <div class="relative pt-6 sm:pt-24 font-sans">
    <ProjectBreadcrumb name={project.name} />

    <!-- Dynamic Image Gallery -->
    {
      project.images ? (
        <div class="mx-auto mt-8 max-w-2xl px-4 sm:px-6 md:max-w-5xl md:px-8">
          <div class={`grid grid-cols-1 ${project.aspect?.includes('9/19') || project.aspect?.includes('9/16') ? 'sm:grid-cols-2 md:grid-cols-6' : 'md:grid-cols-2'} gap-6 md:gap-8 items-start`}>
            {projectImages.map((img, i) => {
              const imagePath = project.images[i] || "";
              // Identify landscape/web images based on filename conventions
              const isLandscape = imagePath.includes("screenshot") || imagePath.includes("desktop") || imagePath.includes("web") || imagePath.includes("landscape");
              const isMobileGrid = project.aspect?.includes('9/19') || project.aspect?.includes('9/16');
              
              const currentAspect = isLandscape ? "aspect-video" : aspectClass;
              
              let spanClass = '';
              if (isMobileGrid) {
                 // Mobile images take 2/6 (33%), Landscape images take 3/6 (50%) - exactly 1.5x bigger!
                 spanClass = isLandscape ? 'sm:col-span-2 md:col-span-3' : 'sm:col-span-1 md:col-span-2';
              }

              return (
              <div class={`group relative ${currentAspect} ${spanClass} overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-50/80 backdrop-blur-sm shadow-lg shadow-zinc-200/40 hover:shadow-zinc-300/60 hover:border-zinc-300 hover:-translate-y-1 transition-all duration-500`}>
                <div class="h-full w-full relative overflow-hidden">
                  <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10" />
                  <Image
                    src={img()}
                    alt={`${project.name} screenshot ${i + 1}`}
                    class="h-full w-full object-contain transform group-hover:scale-102 transition-transform duration-700 relative z-10"
                  />
                  <div class="absolute inset-0 bg-zinc-50/50 backdrop-blur-2xl" />
                </div>
              </div>
            )})}
          </div>
        </div>
      ) : (
        <slot name="demo" />
      )
    }

    <!-- Product info -->
    <div
      class="mx-auto max-w-2xl px-4 pb-0 pt-12 sm:px-6 md:grid md:max-w-5xl md:grid-cols-3 md:gap-x-8 md:px-8 md:pb-24 md:pt-16"
    >
      <div class="md:col-span-2 space-y-8">
        <div class="space-y-4">
            <h1 class="text-3xl sm:text-5xl font-black text-zinc-900 tracking-tight leading-tight pb-2">
                {project.name}
            </h1>
            <div class="h-1 w-20 bg-sky-500 rounded-full"></div>
        </div>

        <div class="rounded-2xl border border-zinc-200 bg-zinc-50/40 backdrop-blur-sm p-6 sm:p-10 shadow-md">
          <ProseWrapper>
            <div class="text-lg leading-relaxed text-zinc-700">
              <slot />
            </div>
          </ProseWrapper>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="mt-12 md:mt-0 space-y-6">
        {project.tags && (
          <div class="p-6 rounded-2xl border border-zinc-200/80 bg-zinc-50/80 backdrop-blur-xl shadow-md">
            <h3 class="text-xs font-bold text-zinc-400 uppercase tracking-[0.2em] mb-4">Technologies</h3>
            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag: string) => (
                <Badge size="lg">{tag}</Badge>
              ))}
            </div>
          </div>
        )}

        <div class="p-6 rounded-2xl border border-zinc-200/80 bg-zinc-50/80 backdrop-blur-xl shadow-md">
          <h3 class="text-xs font-bold text-zinc-400 uppercase tracking-[0.2em] mb-4">Quick Actions</h3>
          <div class="flex flex-col gap-3">
            <ProjectButtons
              codeUrl={project.codeUrl}
              projectUrl={project.projectUrl}
            />
          </div>
        </div>

        <div class="p-6 rounded-2xl border border-zinc-200/80 bg-gradient-to-br from-sky-50/30 to-cyan-50/30 backdrop-blur-xl shadow-md">
          <div class="flex items-center gap-3 text-sm text-zinc-600 font-semibold">
            <div class="w-8 h-8 rounded-full bg-sky-50 border border-sky-200 flex items-center justify-center">
                <svg class="w-4 h-4 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
            </div>
            <span>Built with passion</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
