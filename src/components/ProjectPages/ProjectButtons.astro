---
interface Props {
  codeUrl?: string;
  projectUrl?: string;
}

const { codeUrl, projectUrl } = Astro.props;
---

{
  codeUrl ? (
    <a
      href={codeUrl}
      target="_blank"
      class="flex w-full items-center font-bold justify-center rounded-full bg-zinc-50 border-zinc-200 border px-8 py-3 text-base text-zinc-800 hover:bg-zinc-100 hover:border-zinc-300 transition-all duration-200"
    >
      check out the code
    </a>
  ) : null
}

{
  projectUrl ? (
    <a
      href={projectUrl}
      target="_blank"
      class="flex w-full items-center justify-center rounded-full text-white bg-sky-500 hover:bg-sky-600 px-8 py-3 text-base font-bold shadow-lg shadow-sky-500/10 hover:shadow-sky-500/20 transition-all duration-200"
    >
      launch project
    </a>
  ) : null
}
