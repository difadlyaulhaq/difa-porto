---
import Image from "astro/components/Image.astro";
import Badge from "../Helper/Badge.astro";
import ProjectBreadcrumb from "./ProjectBreadcrumb.astro";
import ProjectButtons from "./ProjectButtons.astro";
import ProseWrapper from "$layouts/ProseWrapper.astro";

const { project } = Astro.props;

const images = import.meta.glob(
  "/src/assets/projects/**/*.{png,webp,jpg,jpeg}"
);
const projectImages = await Promise.all(
  (project.images || []).map(async (image: string) => images[image])
);
---

<div class="text-zinc-800 font-sans min-h-screen bg-white">
  <div class="pt-6 sm:pt-24 font-sans">
    <ProjectBreadcrumb name={project.name} />

    <!-- Image gallery with enhanced styling -->
    {
      project.images ? (
        <div class="mx-auto mt-6 max-w-2xl sm:px-6 md:grid md:max-w-5xl md:grid-cols-3 md:gap-x-8 md:px-8">
          {/* Main large image */}
          <div class="group aspect-h-4 aspect-w-3 hidden overflow-hidden rounded-3xl md:block border border-zinc-200 bg-zinc-50/80 backdrop-blur-sm shadow-lg shadow-zinc-200/40 hover:shadow-zinc-300/60 hover:border-zinc-300 transition-all duration-500 relative">
            <div class="h-full w-full relative overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-sky-500/5 via-transparent to-cyan-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
              <Image
                src={projectImages[0]()}
                alt=""
                height={2400}
                width={2000}
                class="h-full w-full object-contain transform group-hover:scale-102 transition-transform duration-700 relative z-10"
              />
              <div class="absolute inset-0 bg-zinc-50/50 backdrop-blur-2xl" />
            </div>
          </div>

          {/* Side images */}
          <div class="hidden md:grid md:grid-cols-1 md:gap-y-8">
            <div class="group aspect-h-2 aspect-w-3 overflow-hidden rounded-3xl border border-zinc-200 bg-zinc-50/80 backdrop-blur-sm shadow-lg shadow-zinc-200/40 hover:shadow-zinc-300/60 hover:border-zinc-300 transition-all duration-500 relative">
              <div class="h-full w-full relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-sky-500/5 via-transparent to-cyan-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                <Image
                  src={projectImages[1]()}
                  alt=""
                  height={1200}
                  width={1800}
                  class="h-full w-full object-contain transform group-hover:scale-102 transition-transform duration-700 relative z-10"
                />
                <div class="absolute inset-0 bg-zinc-50/50 backdrop-blur-2xl" />
              </div>
            </div>
            <div class="group aspect-h-2 aspect-w-3 overflow-hidden rounded-3xl border border-zinc-200 bg-zinc-50/80 backdrop-blur-sm shadow-lg shadow-zinc-200/40 hover:shadow-zinc-300/60 hover:border-zinc-300 transition-all duration-500 relative">
              <div class="h-full w-full relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-sky-500/5 via-transparent to-cyan-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                <Image
                  src={projectImages[2]()}
                  alt=""
                  height={1200}
                  width={1800}
                  class="h-full w-full object-contain transform group-hover:scale-102 transition-transform duration-700 relative z-10"
                />
                <div class="absolute inset-0 bg-zinc-50/50 backdrop-blur-2xl" />
              </div>
            </div>
          </div>

          {/* Right large image */}
          <div class="group aspect-h-5 aspect-w-4 md:aspect-h-4 md:aspect-w-3 sm:overflow-hidden sm:rounded-3xl border-y sm:border border-zinc-200 bg-zinc-50/80 backdrop-blur-sm shadow-lg shadow-zinc-200/40 hover:shadow-zinc-300/60 hover:border-zinc-300 transition-all duration-500 relative">
            <div class="h-full w-full relative overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-sky-500/5 via-transparent to-cyan-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
              <Image
                src={projectImages[3]()}
                alt=""
                height={2400}
                width={2000}
                class="h-full w-full object-contain transform group-hover:scale-102 transition-transform duration-700 relative z-10"
              />
              <div class="absolute inset-0 bg-zinc-50/50 backdrop-blur-2xl" />
            </div>
          </div>
        </div>
      ) : (
        <slot name="demo" />
      )
    }

    <!-- Product info with enhanced cards -->
    <div
      class="mx-auto max-w-2xl px-4 pb-0 pt-10 sm:px-6 md:grid md:max-w-5xl md:grid-cols-3 md:grid-rows-[auto,auto,1fr] md:gap-x-8 md:px-8 md:pb-24 md:pt-16"
    >
      <div
        class="md:col-span-2 md:border-r md:border-zinc-200 md:pr-8"
      >
        <h1
          class="text-2xl font-black tracking-tight sm:text-4xl text-zinc-900 font-sans leading-tight pb-2"
        >
          {project.name}
        </h1>
      </div>

      <!-- Options sidebar with glass morphism -->
      <div class="mt-4 md:row-span-3 md:mt-0">
        <div class="sticky top-24 space-y-6">
          {
            project.tags && (
              <div class="p-6 rounded-2xl border border-zinc-200/80 bg-zinc-50/80 backdrop-blur-xl shadow-md">
                <h3 class="text-sm font-bold text-zinc-400 uppercase tracking-wider mb-4">Technologies</h3>
                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag: string) => (
                    <Badge size="lg">{tag}</Badge>
                  ))}
                </div>
              </div>
            )
          }

          <div class="p-6 rounded-2xl border border-zinc-200/80 bg-zinc-50/80 backdrop-blur-xl shadow-md">
            <h3 class="text-sm font-bold text-zinc-400 uppercase tracking-wider mb-4">Quick Actions</h3>
            <div class="flex flex-col gap-3">
              <ProjectButtons
                codeUrl={project.codeUrl}
                projectUrl={project.projectUrl}
              />
            </div>
          </div>

          {/* Additional info card */}
          <div class="p-6 rounded-2xl border border-zinc-200/80 bg-gradient-to-br from-sky-50/30 to-cyan-50/30 backdrop-blur-xl shadow-md">
            <div class="flex items-center gap-3 text-sm text-zinc-600 font-semibold">
              <svg class="w-5 h-5 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              <span>Built with passion</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Content area with enhanced prose -->
      <div
        class="py-10 md:col-span-2 md:col-start-1 md:border-r md:border-zinc-200 md:pb-16 md:pr-8 md:pt-6"
      >
        <div class="prose-enhanced rounded-2xl border border-zinc-200 bg-zinc-50/40 backdrop-blur-sm p-6 sm:p-8 shadow-md">
          <ProseWrapper>
            <div class="text-base leading-relaxed tracking-wide text-zinc-700">
              <slot />
            </div>
          </ProseWrapper>
        </div>
      </div>
    </div>

    {/* Mobile images with enhanced styling */}
    {
      project.images ? (
        <div class="mx-auto mt-6 max-w-2xl sm:px-6 md:hidden pb-24 space-y-4">
          <div class="group aspect-[9/16] overflow-hidden sm:rounded-3xl border-y sm:border border-zinc-200 bg-zinc-50/80 backdrop-blur-sm shadow-md hover:border-zinc-300 hover:shadow-lg transition-all duration-500 relative">
            <div class="h-full w-full relative overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-sky-500/5 via-transparent to-cyan-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
              <Image
                src={projectImages[1]()}
                height={1600}
                width={900}
                alt=""
                class="h-full w-full object-contain transform group-hover:scale-102 transition-transform duration-700 relative z-10"
              />
              <div class="absolute inset-0 bg-zinc-50/50 backdrop-blur-2xl" />
            </div>
          </div>
          <div class="group aspect-[9/16] overflow-hidden sm:rounded-3xl border-y sm:border border-zinc-200 bg-zinc-50/80 backdrop-blur-sm shadow-md hover:border-zinc-300 hover:shadow-lg transition-all duration-500 relative">
            <div class="h-full w-full relative overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-sky-500/5 via-transparent to-cyan-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
              <Image
                src={projectImages[0]()}
                height={1600}
                width={900}
                alt=""
                class="h-full w-full object-contain transform group-hover:scale-102 transition-transform duration-700 relative z-10"
              />
              <div class="absolute inset-0 bg-zinc-50/50 backdrop-blur-2xl" />
            </div>
          </div>
          <div class="group aspect-[9/16] overflow-hidden sm:rounded-3xl border-y sm:border border-zinc-200 bg-zinc-50/80 backdrop-blur-sm shadow-md hover:border-zinc-300 hover:shadow-lg transition-all duration-500 relative">
            <div class="h-full w-full relative overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-sky-500/5 via-transparent to-cyan-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
              <Image
                src={projectImages[2]()}
                height={1600}
                width={900}
                alt=""
                class="h-full w-full object-contain transform group-hover:scale-102 transition-transform duration-700 relative z-10"
              />
              <div class="absolute inset-0 bg-zinc-50/50 backdrop-blur-2xl" />
            </div>
          </div>
        </div>
      ) : null
    }
  </div>
</div>

<style>
  .prose-enhanced {
    transition: all 0.3s ease;
  }

  .prose-enhanced:hover {
    border-color: rgba(0, 0, 0, 0.15);
    background: rgba(0, 0, 0, 0.01);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
  }
</style>