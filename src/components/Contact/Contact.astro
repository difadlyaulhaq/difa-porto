---
import { SOCIALS } from "src/config";
import SocialLink from "../Helper/SocialLink.astro";
import Bluesky from "$components/Icons/Bluesky.astro";
import LinkedIn from "$components/Icons/LinkedIn.astro";
import Github from "$components/Icons/Github.astro";
import Mail from "$components/Icons/Mail.astro";
import LiquidEther from "../Hero/LiquidEther.svelte";
---

<div class="relative isolate py-32 section overflow-hidden bg-transparent" id="contact">
  <!-- Clean light mode background separator -->
  <div class="absolute inset-0 bg-zinc-50 border-t border-zinc-200/50 -z-10"></div>

  <div class="relative z-10 mx-auto max-w-5xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-x-12 gap-y-10 md:grid-cols-2 items-center">
      <div>
        <h2
          class="text-3xl sm:text-4xl font-black tracking-tight text-zinc-900 uppercase pointer-events-auto"
        >
          get in touch
        </h2>
        <p
          class="mt-4 leading-7 text-zinc-600 pointer-events-auto text-sm sm:text-base font-medium"
        >
          you have a project in mind? let's talk about it. drop me a line and
          I'll get back to you as soon as possible.
        </p>
      </div>

      <div class="pointer-events-auto">
        <ul role="list" class="space-y-4">
          <li>
            <a href={SOCIALS.GITHUB} target="_blank" class="flex items-center gap-4 p-4 rounded-2xl bg-white border border-zinc-200 shadow-sm hover:border-sky-500/30 hover:bg-sky-50 transition-all duration-300 hover:scale-105 hover:shadow-[0_8px_30px_rgba(14,165,233,0.04)] text-zinc-700 hover:text-sky-600">
              <Github class="w-6 h-6 text-sky-600" />
              <span class="font-bold tracking-wide">github</span>
            </a>
          </li>
          <li>
            <a href={SOCIALS.LINKEDIN} target="_blank" class="flex items-center gap-4 p-4 rounded-2xl bg-white border border-zinc-200 shadow-sm hover:border-sky-500/30 hover:bg-sky-50 transition-all duration-300 hover:scale-105 hover:shadow-[0_8px_30px_rgba(14,165,233,0.04)] text-zinc-700 hover:text-sky-600">
              <LinkedIn class="w-6 h-6 text-sky-600" />
              <span class="font-bold tracking-wide">linkedin</span>
            </a>
          </li>
          <li>
            <a href={SOCIALS.MAIL} class="flex items-center gap-4 p-4 rounded-2xl bg-white border border-zinc-200 shadow-sm hover:border-sky-500/30 hover:bg-sky-50 transition-all duration-300 hover:scale-105 hover:shadow-[0_8px_30px_rgba(14,165,233,0.04)] text-zinc-700 hover:text-sky-600">
              <Mail class="w-6 h-6 text-sky-600" />
              <span class="font-bold tracking-wide">{SOCIALS.MAIL.replace("mailto:", "")}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
