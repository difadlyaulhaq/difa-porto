---
import { getImage } from "astro:assets";
import { cn } from "src/utils";
import MagicBento from "./MagicBento.jsx";

type Props = {
  projects: Array<{
    slug: string;
    data: {
      name: string;
      thumbnail: ImageMetadata;
      aspect?: string;
      video?: string;
      mainTags?: Array<string>;
      description?: string;
      tags?: Array<string>;
    };
  }>;
};

const { projects } = Astro.props;

// Process projects to get optimized image URLs
const processedProjects = await Promise.all(
  projects.map(async (project) => {
    const optimizedImage = await getImage({
      src: project.data.thumbnail,
      width: 600,
      format: "webp",
    });

    return {
      title: project.data.name,
      slug: project.slug,
      image: optimizedImage.src,
      tags: project.data.mainTags || project.data.tags || [],
      description: project.data.description || "",
      // Add a default color if needed, or random
      color: '#060010'
    };
  })
);
---

<div
  id="projects"
  class="z-20 py-16 md:py-32 section bg-background relative isolate overflow-hidden"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-2xl mb-12">
      <h1
        class="text-4xl font-bold tracking-tight text-base-800 dark:text-base-100 sm:text-5xl"
      >
        Highlighted Projects
      </h1>
      <div class="mt-6 text-base text-base-600 dark:text-base-400">
        I love turning ideas into real products, and these projects are a reflection of that.
        From hackathons to weekend experiments, here are some of the things I've recently built.
        Curious about the code? Many are open-source and open for feedback.
      </div>
    </div>

    <MagicBento 
      client:visible 
      items={processedProjects} 
      enableSpotlight={true} 
      enableTilt={true}
    />
    
    <div class="mt-12 text-center">
        <a href="/projects" class="inline-flex items-center gap-2 px-6 py-3 bg-white/5 border border-white/10 rounded-full hover:bg-white/10 transition-colors text-white font-medium">
            See all projects →
        </a>
    </div>
  </div>
</div>
