---
import { getImage } from "astro:assets";
import FeaturedProjects from "./FeaturedProjects.svelte";

type Props = {
  projects: Array<{
    slug: string;
    data: {
      name: string;
      thumbnail: ImageMetadata;
      aspect?: string;
      video?: string;
      mainTags?: Array<string>;
      shortDescription?: string;
      description?: string;
      tags?: Array<string>;
    };
  }>;
};

const { projects } = Astro.props;

// Process projects to get optimized image URLs
const processedProjects = await Promise.all(
  projects.map(async (project) => {
    const optimizedImage = await getImage({
      src: project.data.thumbnail,
      width: 600,
      format: "webp",
    });

    return {
      title: project.data.name,
      slug: project.slug,
      image: optimizedImage.src,
      tags: project.data.mainTags || project.data.tags || [],
      description: project.data.shortDescription || project.data.description || "",
    };
  })
);
---

<div
  id="projects"
  class="z-20 py-16 md:py-32 section bg-transparent relative isolate overflow-hidden"
>
  <!-- Subtle background dot grid for projects section -->
  <div class="absolute inset-0 bg-[radial-gradient(rgba(0,0,0,0.02)_1.5px,transparent_1.5px)] bg-[size:24px_24px] pointer-events-none -z-10"></div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="text-center mb-16 space-y-3">
      <h2 class="text-4xl md:text-5xl font-black text-zinc-900 uppercase tracking-tighter block">
        Featured Projects
      </h2>
      <p class="text-zinc-500 max-w-2xl mx-auto text-sm sm:text-base font-medium">
        A collection of my recent work, side projects, and experiments.
      </p>
    </div>

    <FeaturedProjects 
      client:visible 
      projects={processedProjects} 
    />
    
    <div class="mt-16 text-center">
        <a href="/projects" class="inline-flex items-center gap-2 px-6 py-3 bg-white border border-zinc-200 rounded-full hover:bg-zinc-50 hover:border-sky-500/30 transition-all duration-300 text-zinc-800 font-bold hover:scale-105 shadow-md">
            See all projects →
        </a>
    </div>
  </div>
</div>
