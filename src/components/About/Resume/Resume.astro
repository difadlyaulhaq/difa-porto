---
import amikom from "$assets/about/logos/amikom.png";
import bangkit from "$assets/about/logos/Bangkit.png";
import amcc from "$assets/about/logos/amcc.png";
import freelance from "$assets/about/logos/freelance.png";
import ResumeBounceCards from "./ResumeBounceCards.jsx";
import type { ImageMetadata } from "astro";

// Award/Competition images (using placeholders or existing logos for now if specific ones aren't available yet)
// You should replace these with actual award logos
import gemastik from "$assets/about/logos/amcc.png"; // Placeholder
import hackathon from "$assets/about/logos/Bangkit.png"; // Placeholder

let resume: Array<{
  company: string;
  title: string;
  logo: ImageMetadata;
  start: string | { label: string; dateTime: string };
  end: string | { label: string; dateTime: string };
  description?: string;
  tags?: string[];
}> = [
  {
    company: "Independent Freelancer",
    title: "Mobile & Web Developer",
    logo: freelance,
    start: "2023",
    end: {
      label: "present",
      dateTime: new Date().getFullYear().toString(),
    },
    description: "Delivering high-quality mobile and web solutions for clients. Specializing in Flutter for cross-platform apps and modern web frameworks.",
    tags: ["Flutter", "React", "Node.js", "Firebase"]
  },
  {
    company: "Amikom Computer Club",
    title: "HR Department",
    logo: amcc,
    start: "June 2024",
    end: {
      label: "present",
      dateTime: new Date().getFullYear().toString(),
    },
    description: "Managing human resources, organizing events, and fostering a collaborative community environment within the club.",
    tags: ["Leadership", "Management", "Communication"]
  },
  {
    company: "Bangkit 2024",
    title: "Machine Learning Cohort",
    logo: bangkit,
    start: "Sept 2024",
    end: {
      label: "Dec 2024",
      dateTime: new Date().getFullYear().toString(),
    },
    description: "Intensive career readiness program led by Google, GoTo, and Traveloka. Gained deep knowledge in Machine Learning and Soft Skills.",
    tags: ["TensorFlow", "Python", "Deep Learning", "Soft Skills"]
  },
  {
    company: "Amikom Computer Club",
    title: "Head of Mobile Div",
    logo: amcc,
    start: "Dec 2023",
    end: {
      label: "June 2024",
      dateTime: new Date().getFullYear().toString(),
    },
    description: "Led the Mobile Programming division, creating curriculum, mentoring members, and overseeing mobile development projects.",
    tags: ["Mentoring", "Curriculum Design", "Flutter", "Kotlin"]
  },
  {
    company: "Amikom Yogyakarta",
    title: "Informatics Student",
    logo: amikom,
    start: "2022",
    end: {
      label: "present",
      dateTime: new Date().getFullYear().toString(),
    },
    description: "Pursuing a Bachelor's degree in Informatics. Active in student organizations and maintaining a high GPA.",
    tags: ["Algorithms", "Data Structures", "Software Engineering"]
  },
];

let awards = [
    {
        title: "Finalist Gemastik 2024",
        company: "Gemastik", // Context
        logo: gemastik,
        start: "2024",
        end: "2024",
        description: "Reached the finals in the UX Design category, competing against top universities nationwide.",
        tags: ["UX Design", "Prototyping", "Competition"]
    },
      {
        title: "1st Place Hackathon",
        company: "Local Tech Event",
        logo: hackathon,
        start: "2023",
        end: "2023",
        description: "Won first prize in a 24-hour coding hackathon by building an innovative solution for waste management.",
        tags: ["Innovation", "Rapid Prototyping", "Teamwork"]
    }
];

// Map resume and award data
const resumeData = resume.map(item => ({
  ...item,
  logoUrl: item.logo.src
}));

const awardsData = awards.map(item => ({
    ...item,
    logoUrl: item.logo.src
}));
---

<div class="relative w-full lg:mt-16 bg-zinc-950/50 rounded-3xl border border-white/10 overflow-hidden">
  <div class="p-6 border-b border-white/10">
    <h2 class="flex text-sm font-semibold text-base-900 dark:text-base-100 items-center">
      <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6 flex-none" aria-hidden="true">
        <path d="M2.75 9.75a3 3 0 0 1 3-3h12.5a3 3 0 0 1 3 3v8.5a3 3 0 0 1-3 3H5.75a3 3 0 0 1-3-3v-8.5Z" class="fill-base-100 stroke-base-400 dark:fill-base-100/10 dark:stroke-base-500"></path>
        <path d="M3 14.25h6.249c.484 0 .952-.002 1.316.319l.777.682a.996.996 0 0 0 1.316 0l.777-.682c.364-.32.832-.319 1.316-.319H21M8.75 6.5V4.75a2 2 0 0 1 2-2h2.5a2 2 0 0 1 2 2V6.5" class="stroke-base-400 dark:stroke-base-500"></path>
      </svg>
      <span class="ml-3">Experience & Awards</span>
    </h2>
  </div>

  <div class="p-4 flex justify-center w-full overflow-x-hidden">
      <ResumeBounceCards client:visible resume={resumeData} awards={awardsData} />
  </div>
</div>
