---
import imageMePng from "$assets/about/me/me2.png";

import ProseWrapper from "$layouts/ProseWrapper.astro";
import Resume from "./Resume/Resume.astro";
import ProfileCard from "./ProfileCard.svelte";

import { Content } from "$content/main/about.md";
---

<head>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
</head>

<div class="relative isolate overflow-hidden bg-background font-sans dark">
  <div class="mx-auto max-w-5xl px-6 lg:px-8">
    <div id="about" class="py-16 md:py-32 section">
      <div class="grid grid-cols-1 gap-y-16 lg:grid-cols-2 lg:grid-rows-[auto_1fr] lg:gap-y-12">
        <div class="lg:pl-20 w-full flex lg:justify-center">
          <div class="max-w-sm px-2.5 lg:max-w-none">
            <div class="rotate-2 -m-10 lg:-m-16 hover:rotate-0 transition-transform duration-500 ease-out">
              <div id="me3d" class="w-full h-full">
                <ProfileCard
                  client:only="svelte"
                  name="Difa Dlyaul Haq"
                  title="Software Engineer"
                  handle="difadlyh"
                  status="Online"
                  contactText="Contact Me"
                  avatarUrl={imageMePng.src}
                  showUserInfo={true}
                  enableTilt={true}
                  enableMobileTilt={false}
                />
              </div>
              <div class="sr-only">this is me</div>
            </div>
          </div>
        </div>
        <div class="lg:order-first lg:row-span-2">
          <ProseWrapper
            class="prose-h1:text-4xl prose-h1:sm:text-5xl prose-h1:tracking-tight prose-a:font-bold"
          >
            <Content />
          </ProseWrapper>
        </div>

        <div class="lg:pl-20 flex flex-col gap-12">
          <Resume />
        </div>
      </div>
    </div>
  </div>
</div>
